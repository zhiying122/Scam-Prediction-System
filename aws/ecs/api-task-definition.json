{
  "family": "scam-prediction-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "scam-prediction-api",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/scam-prediction-api:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "APP_ENV",    "value": "production" },
        { "name": "LOG_LEVEL",  "value": "INFO" }
      ],
      "secrets": [
        { "name": "OPENAI_API_KEY",    "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:scam-prediction/openai-api-key" },
        { "name": "POSTGRES_PASSWORD", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:scam-prediction/postgres-password" },
        { "name": "API_KEY",           "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:scam-prediction/api-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/scam-prediction-api",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/v1/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 40
      }
    }
  ]
}
