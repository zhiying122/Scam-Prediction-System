# AI 詐騙進化預測系統 - 環境變數範本
# 複製此檔案為 .env 並填入實際值

# ── 應用程式設定 ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL 設定 ───────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scam_prediction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ── Redis 設定 ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Qdrant 設定 ───────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── LLM API 設定（主要 GPT，失敗時自動切換 Ollama）────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
LLM_FALLBACK=ollama
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=300
# Dashboard 呼叫 API Gateway 逾時（秒）；話術生成預設為 LLM_TIMEOUT_SECONDS * 2 + 60
# DASHBOARD_API_TIMEOUT_SECONDS=60
# DASHBOARD_LLM_GENERATE_TIMEOUT_SECONDS=660

# Google Gemini（備用）
# LLM_PROVIDER=google
# GOOGLE_API_KEY=your-google-api-key-here

# ── API Gateway 設定 ──────────────────────────────────────────────────────────
API_KEY=your-api-key-here
API_RATE_LIMIT_DEFAULT=100
API_RATE_LIMIT_WINDOW_SECONDS=60

# ── AWS 部署設定（僅生產環境需要）───────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-northeast-1
# Streamlit 連接後端 API 的 URL（ECS 部署後填入 Public IP 或 ALB DNS）
API_GATEWAY_URL=http://localhost:8001

# ── Dashboard 本機管理員（僅寫入本機 .env 或 .env.local，勿提交 Git；登入頁不會顯示）─
# 建議個人帳號放 .env.local（已被 .gitignore 排除）
# 格式：帳號:密碼 或 帳號:密碼:顯示名稱；多組以逗號分隔
# DASHBOARD_LOCAL_ADMINS=your_username:your_password:您的顯示名稱
