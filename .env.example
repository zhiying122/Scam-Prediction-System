# AI 詐騙進化預測系統 - 環境變數範本
# 複製此檔案為 .env 並填入實際值

# ── 應用程式設定 ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL 設定 ───────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scam_prediction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ── Redis 設定 ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Qdrant 設定 ───────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── LLM API 設定（擇一填入）──────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini（備用）
# LLM_PROVIDER=google
# GOOGLE_API_KEY=your-google-api-key-here

# ── API Gateway 設定 ──────────────────────────────────────────────────────────
API_KEY=your-api-key-here
API_RATE_LIMIT_DEFAULT=100
API_RATE_LIMIT_WINDOW_SECONDS=60

# ── AWS 部署設定（僅生產環境需要）───────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-northeast-1
# Streamlit 連接後端 API 的 URL（ECS 部署後填入 Public IP 或 ALB DNS）
API_GATEWAY_URL=http://localhost:8000
